{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "AWSFlow: bounded S3/EventBridge/SQS/Lambda data pipeline with Glue catalog and Athena",
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String",
      "Description": "Existing deployment artifact bucket in the same region"
    },
    "ArtifactKey": {
      "Type": "String",
      "Description": "Content-addressed Lambda ZIP object key"
    },
    "DatabaseName": {
      "Type": "String",
      "Default": "awsflow_demo",
      "AllowedPattern": "[a-z][a-z0-9_]{0,63}"
    }
  },
  "Resources": {
    "DataBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "NotificationConfiguration": {
          "EventBridgeConfiguration": {
            "EventBridgeEnabled": true
          }
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "DemoRetention",
              "Status": "Enabled",
              "ExpirationInDays": 30,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 7
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "BucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "DataBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "DataBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${DataBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "DeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 1209600
      }
    },
    "WorkQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "SqsManagedSseEnabled": true,
        "VisibilityTimeout": 720,
        "MessageRetentionPeriod": 345600,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "DeadLetterQueue",
              "Arn"
            ]
          },
          "maxReceiveCount": 5
        }
      }
    },
    "WorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "DataAndQueue",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "${DataBucket.Arn}/bronze/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": [
                    {
                      "Fn::Sub": "${DataBucket.Arn}/silver/*"
                    },
                    {
                      "Fn::Sub": "${DataBucket.Arn}/quarantine/*"
                    },
                    {
                      "Fn::Sub": "${DataBucket.Arn}/audit/*"
                    },
                    {
                      "Fn::Sub": "${DataBucket.Arn}/commits/*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "WorkQueue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Worker": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Runtime": "python3.12",
        "Handler": "awsflow.worker.lambda_handler",
        "Role": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "ArtifactKey"
          }
        },
        "Timeout": 120,
        "MemorySize": 512,
        "Environment": {
          "Variables": {
            "DATA_BUCKET": {
              "Ref": "DataBucket"
            },
            "MAX_BYTES": "8388608"
          }
        }
      }
    },
    "WorkerLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${Worker}"
        },
        "RetentionInDays": 7
      }
    },
    "WorkerLogsPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "WorkerLogs",
        "Roles": [
          {
            "Ref": "WorkerRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "WorkerLogGroup",
                  "Arn"
                ]
              }
            }
          ]
        }
      }
    },
    "QueueMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "EventSourceArn": {
          "Fn::GetAtt": [
            "WorkQueue",
            "Arn"
          ]
        },
        "FunctionName": {
          "Ref": "Worker"
        },
        "BatchSize": 5,
        "FunctionResponseTypes": [
          "ReportBatchItemFailures"
        ],
        "ScalingConfig": {
          "MaximumConcurrency": 2
        },
        "Enabled": true
      },
      "DependsOn": [
        "WorkerLogsPolicy"
      ]
    },
    "BronzeRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "EventPattern": {
          "source": [
            "aws.s3"
          ],
          "detail-type": [
            "Object Created"
          ],
          "detail": {
            "bucket": {
              "name": [
                {
                  "Ref": "DataBucket"
                }
              ]
            },
            "object": {
              "key": [
                {
                  "prefix": "bronze/"
                }
              ]
            }
          }
        },
        "Targets": [
          {
            "Id": "Queue",
            "Arn": {
              "Fn::GetAtt": [
                "WorkQueue",
                "Arn"
              ]
            },
            "RetryPolicy": {
              "MaximumRetryAttempts": 10,
              "MaximumEventAgeInSeconds": 3600
            },
            "DeadLetterConfig": {
              "Arn": {
                "Fn::GetAtt": [
                  "DeadLetterQueue",
                  "Arn"
                ]
              }
            }
          }
        ]
      }
    },
    "QueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "Queues": [
          {
            "Ref": "WorkQueue"
          },
          {
            "Ref": "DeadLetterQueue"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "events.amazonaws.com"
              },
              "Action": "sqs:SendMessage",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "WorkQueue",
                    "Arn"
                  ]
                },
                {
                  "Fn::GetAtt": [
                    "DeadLetterQueue",
                    "Arn"
                  ]
                }
              ],
              "Condition": {
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Fn::GetAtt": [
                      "BronzeRule",
                      "Arn"
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "Database": {
      "Type": "AWS::Glue::Database",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseInput": {
          "Name": {
            "Ref": "DatabaseName"
          }
        }
      }
    },
    "SilverTable": {
      "Type": "AWS::Glue::Table",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseName": {
          "Ref": "Database"
        },
        "TableInput": {
          "Name": "requests_silver",
          "TableType": "EXTERNAL_TABLE",
          "PartitionKeys": [
            {
              "Name": "dt",
              "Type": "string"
            }
          ],
          "Parameters": {
            "classification": "json",
            "EXTERNAL": "TRUE",
            "projection.enabled": "true",
            "projection.dt.type": "date",
            "projection.dt.range": "2020-01-01,NOW",
            "projection.dt.format": "yyyy-MM-dd",
            "projection.dt.interval": "1",
            "projection.dt.interval.unit": "DAYS",
            "storage.location.template": {
              "Fn::Sub": "s3://${DataBucket}/silver/dt=${!dt}/"
            }
          },
          "StorageDescriptor": {
            "Location": {
              "Fn::Sub": "s3://${DataBucket}/silver/"
            },
            "InputFormat": "org.apache.hadoop.mapred.TextInputFormat",
            "OutputFormat": "org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat",
            "SerdeInfo": {
              "SerializationLibrary": "org.apache.hive.hcatalog.data.JsonSerDe"
            },
            "Columns": [
              {
                "Name": "unique_key",
                "Type": "string"
              },
              {
                "Name": "created_date",
                "Type": "string"
              },
              {
                "Name": "closed_date",
                "Type": "string"
              },
              {
                "Name": "agency",
                "Type": "string"
              },
              {
                "Name": "complaint_type",
                "Type": "string"
              },
              {
                "Name": "borough",
                "Type": "string"
              },
              {
                "Name": "status",
                "Type": "string"
              },
              {
                "Name": "resolution_hours",
                "Type": "double"
              },
              {
                "Name": "batch_id",
                "Type": "string"
              },
              {
                "Name": "ingested_at",
                "Type": "string"
              }
            ]
          }
        }
      }
    },
    "CommitTable": {
      "Type": "AWS::Glue::Table",
      "Properties": {
        "CatalogId": {
          "Ref": "AWS::AccountId"
        },
        "DatabaseName": {
          "Ref": "Database"
        },
        "TableInput": {
          "Name": "batch_commits",
          "TableType": "EXTERNAL_TABLE",
          "Parameters": {
            "classification": "json",
            "EXTERNAL": "TRUE"
          },
          "StorageDescriptor": {
            "Location": {
              "Fn::Sub": "s3://${DataBucket}/commits/"
            },
            "InputFormat": "org.apache.hadoop.mapred.TextInputFormat",
            "OutputFormat": "org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat",
            "SerdeInfo": {
              "SerializationLibrary": "org.apache.hive.hcatalog.data.JsonSerDe"
            },
            "Columns": [
              {
                "Name": "batch_id",
                "Type": "string"
              },
              {
                "Name": "ingested_at",
                "Type": "string"
              },
              {
                "Name": "status",
                "Type": "string"
              },
              {
                "Name": "source_rows",
                "Type": "int"
              },
              {
                "Name": "accepted",
                "Type": "int"
              },
              {
                "Name": "rejected",
                "Type": "int"
              }
            ]
          }
        }
      }
    },
    "AthenaWorkGroup": {
      "Type": "AWS::Athena::WorkGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-analytics"
        },
        "RecursiveDeleteOption": true,
        "WorkGroupConfiguration": {
          "EnforceWorkGroupConfiguration": true,
          "PublishCloudWatchMetricsEnabled": true,
          "BytesScannedCutoffPerQuery": 104857600,
          "ResultConfiguration": {
            "OutputLocation": {
              "Fn::Sub": "s3://${DataBucket}/athena-results/"
            },
            "EncryptionConfiguration": {
              "EncryptionOption": "SSE_S3"
            }
          }
        }
      }
    },
    "FailureMetric": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "WorkerLogGroup"
        },
        "FilterPattern": "{ $.kind = \"awsflow_failure\" }",
        "MetricTransformations": [
          {
            "MetricNamespace": "AWSFlow",
            "MetricName": {
              "Fn::Sub": "${AWS::StackName}-Failures"
            },
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "FailureAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Worker reported a failed SQS item; inspect logs and DLQ",
        "Namespace": "AWSFlow",
        "MetricName": {
          "Fn::Sub": "${AWS::StackName}-Failures"
        },
        "Statistic": "Sum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "QualityMetric": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "LogGroupName": {
          "Ref": "WorkerLogGroup"
        },
        "FilterPattern": "{ $.kind = \"awsflow_batch\" && $.status = \"blocked_quality_gate\" }",
        "MetricTransformations": [
          {
            "MetricNamespace": "AWSFlow",
            "MetricName": {
              "Fn::Sub": "${AWS::StackName}-QualityBlocks"
            },
            "MetricValue": "1",
            "DefaultValue": 0
          }
        ]
      }
    },
    "QualityAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Batch quarantined by quality gate; inspect audit/quarantine objects",
        "Namespace": "AWSFlow",
        "MetricName": {
          "Fn::Sub": "${AWS::StackName}-QualityBlocks"
        },
        "Statistic": "Sum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "DlqAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Pipeline/event delivery exhausted retries",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "DeadLetterQueue",
                "QueueName"
              ]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    }
  },
  "Outputs": {
    "DataBucket": {
      "Value": {
        "Ref": "DataBucket"
      }
    },
    "WorkerName": {
      "Value": {
        "Ref": "Worker"
      }
    },
    "DatabaseName": {
      "Value": {
        "Ref": "Database"
      }
    },
    "WorkGroupName": {
      "Value": {
        "Ref": "AthenaWorkGroup"
      }
    },
    "QueueUrl": {
      "Value": {
        "Ref": "WorkQueue"
      }
    },
    "DeadLetterQueueUrl": {
      "Value": {
        "Ref": "DeadLetterQueue"
      }
    }
  }
}
